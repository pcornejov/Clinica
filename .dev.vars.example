# Copiar a .dev.vars (no se sube al repo).
# Neon: postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Local: postgresql://postgres:postgres@localhost:5432/clinica
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinica
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiar-por-un-secreto-largo

# URL con la que se abre la app (se usa en los links de correos y WhatsApp).
# APP_URL=http://localhost:5173

# Webpay: "integracion", "produccion" o "simulado".
# TRANSBANK_MODO=simulado

# Correo con Resend (opcional; sin clave los correos se simulan y se ven en el panel).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_REMITENTE=Centro Médico Demo <avisos@tu-dominio.cl>

# WhatsApp Cloud API de Meta (opcional; ver docs/WHATSAPP.md).
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_VERIFY_TOKEN=una-palabra-secreta
# WHATSAPP_APP_SECRET=xxxxxxxx
